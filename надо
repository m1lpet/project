// ---- Модели ----
struct Movie {
    int id;
    std::string title;
    std::string genre;
};

struct Session {
    int id;
    int movie_id;
    std::string date;   // "2025-06-01"
    std::string time;   // "18:30"
    int hall_rows = 5;
    int hall_cols = 8;
};

struct Booking {
    int id;
    int user_id;
    int session_id;
    int row, seat;
    bool active = true;
};

// ---- Простой протокол: "ACTION|arg1|arg2|..." ----
inline std::vector<std::string> split(const std::string& s, char d = '|') {
    std::vector<std::string> out;
    std::stringstream ss(s);
    std::string item;
    while (std::getline(ss, item, d)) out.push_back(item);
    return out;
}

inline std::string join(const std::vector<std::string>& v, char d = '|') {
    std::string out;
    for (size_t i = 0; i < v.size(); ++i) {
        if (i) out += d;
        out += v[i];
    }
    return out;
}













