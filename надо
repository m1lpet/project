int sock_fd;

std::string send_recv(const std::string& req) {
    std::string m = req + "\n";
    send(sock_fd, m.c_str(), m.size(), 0);

    std::string buf;
    char c;
    while (recv(sock_fd, &c, 1, 0) == 1) {
        if (c == '\n') break;
        buf += c;
    }
    return buf;
}

int main() {
    sock_fd = socket(AF_INET, SOCK_STREAM, 0);
    sockaddr_in a{};
    a.sin_family = AF_INET;
    a.sin_port = htons(5555);
    inet_pton(AF_INET, "127.0.0.1", &a.sin_addr);

    if (connect(sock_fd, (sockaddr*)&a, sizeof(a)) < 0) {
        std::cout << "Не удалось подключиться\n";
        return 1;
    }
    std::cout << "Подключено к серверу\n";

    std::string name;
    std::cout << "Ваше имя: ";
    std::cin >> name;
    std::cout << send_recv("LOGIN|" + name) << "\n";

    while (true) {
        std::cout << "\n1) Фильмы  2) Сеансы  3) Места  4) Бронь  "
                     "5) Мои брони  6) Отмена  0) Выход\n> ";
        int cmd; std::cin >> cmd;
        if (cmd == 0) { send_recv("QUIT"); break; }

        if (cmd == 1) {
            auto r = send_recv("MOVIES");
            std::cout << r << "\n";
        }
        else if (cmd == 2) {
            int mid; std::cout << "ID фильма: "; std::cin >> mid;
            std::cout << send_recv("SESSIONS|" + std::to_string(mid)) << "\n";
        }
        else if (cmd == 3) {
            int sid; std::cout << "ID сеанса: "; std::cin >> sid;
            auto r = send_recv("SEATS|" + std::to_string(sid));
            auto parts = split(r);
            std::cout << "Схема зала (X = занято, . = свободно):\n";
            for (size_t i = 1; i < parts.size(); ++i) std::cout << parts[i] << "\n";
        }
        else if (cmd == 4) {
            int sid, row, seat;
            std::cout << "ID сеанса, ряд, место: ";
            std::cin >> sid >> row >> seat;
            std::cout << send_recv("BOOK|" + std::to_string(sid) + "|" +
                                   std::to_string(row) + "|" + std::to_string(seat)) << "\n";
        }
        else if (cmd == 5) {
            std::cout << send_recv("MYBOOKINGS") << "\n";
        }
        else if (cmd == 6) {
            int bid; std::cout << "ID брони: "; std::cin >> bid;
            std::cout << send_recv("CANCEL|" + std::to_string(bid)) << "\n";
        }
    }
    close(sock_fd);
    return 0;
}










